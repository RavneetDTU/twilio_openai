# Copy to .env and fill in. Never commit .env.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5014

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_WEBHOOK_SECRET=
OPENAI_REALTIME_MODEL=
OPENAI_REJECT_ORPHAN_SIP=

# ── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Voice transport / availability flags ─────────────────────────────────────
SIP_TRUNKING_ENABLED=true
RESTAURANT_AVAILABILITY_CHECK_ENABLED=false

# ── Firebase (or put the service-account JSON file in the project root) ──────
FIREBASE_SERVICE_ACCOUNT=

# ── Payments ─────────────────────────────────────────────────────────────────
PAYMENT_FRONTEND_URL=https://payment.booki.co.za
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=false
PAYFAST_NOTIFY_URL=

# ── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GMAIL_USER=
GMAIL_PASS=
GMAIL_FROM=
ENABLE_TEST_EMAIL_API=false

# ── Internal API ─────────────────────────────────────────────────────────────
INTERNAL_API_KEY=

# ── WhatsApp Business Cloud API (Meta) ───────────────────────────────────────
# Off by default. When false, /webhook is not mounted and nothing changes.
WHATSAPP_ENABLED=false
# Permanent System User access token (Meta Business Settings → System users)
WA_TOKEN=
# Phone number ID (WhatsApp Manager → API Setup), not the phone number itself
WA_PHONE_ID=
GRAPH_VERSION=v21.0
# Any random string; enter the same value in the Meta webhook settings
VERIFY_TOKEN=
# Meta App → Settings → Basic → App secret (used for X-Hub-Signature-256)
APP_SECRET=
# Sent for "View Menu" and "Contact Us"
MENU_URL=
CONTACT_INFO=
# Used only when the tenant has no settings.timezone
WA_TIMEZONE=Africa/Johannesburg
# Optional: pin this WhatsApp number to one restaurant. Empty = phoneIndex lookup
# of the WhatsApp display number, then Billy's ("1"), same as voice routing.
WA_RESTAURANT_ID=
# true = also send the existing SMS payment link for WhatsApp bookings
WA_ALSO_SEND_SMS=false
# ai (default) = natural conversation via OpenAI (uses OPENAI_API_KEY); guided = buttons and lists
WA_CONVERSATION_MODE=ai
# Chat model for WhatsApp; empty = gpt-4.1-mini
WA_AI_MODEL=
