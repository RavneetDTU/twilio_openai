# Copy to .env and fill in. Never commit .env.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5014

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_WEBHOOK_SECRET=
OPENAI_REALTIME_MODEL=
OPENAI_REJECT_ORPHAN_SIP=

# ── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Voice transport / availability flags ─────────────────────────────────────
SIP_TRUNKING_ENABLED=true
RESTAURANT_AVAILABILITY_CHECK_ENABLED=false

# ── Firebase (or put the service-account JSON file in the project root) ──────
FIREBASE_SERVICE_ACCOUNT=

# ── Payments ─────────────────────────────────────────────────────────────────
PAYMENT_FRONTEND_URL=https://payment.booki.co.za
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=false
PAYFAST_NOTIFY_URL=

# ── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GMAIL_USER=
GMAIL_PASS=
GMAIL_FROM=
ENABLE_TEST_EMAIL_API=false

# ── Internal API ─────────────────────────────────────────────────────────────
INTERNAL_API_KEY=

# ── WhatsApp Business Cloud API (Meta) ───────────────────────────────────────
# Off by default. When false, /webhook is not mounted and nothing changes.
WHATSAPP_ENABLED=false
# Permanent System User access token (Meta Business Settings → System users)
WA_TOKEN=
# Phone number ID (WhatsApp Manager → API Setup), not the phone number itself
WA_PHONE_ID=
GRAPH_VERSION=v21.0
# Any random string; enter the same value in the Meta webhook settings
VERIFY_TOKEN=
# Meta App → Settings → Basic → App secret (used for X-Hub-Signature-256)
APP_SECRET=
# Sent for "View Menu" and "Contact Us"
MENU_URL=
CONTACT_INFO=
# Used only when the tenant has no settings.timezone
WA_TIMEZONE=Africa/Johannesburg
# Unused for WhatsApp booking destination (guests pick a restaurant by location).
# Voice calls still use dispatcher → phoneIndex → Billy's ("1").
WA_RESTAURANT_ID=
# true = also send the existing SMS payment link for WhatsApp bookings
WA_ALSO_SEND_SMS=false
# ai (default) = natural conversation via OpenAI (uses OPENAI_API_KEY); guided = buttons and lists
WA_CONVERSATION_MODE=ai
# Chat model for WhatsApp; empty = gpt-4.1-mini
WA_AI_MODEL=
# WhatsApp Business Account ID. Required to create and sync message templates.
# The token is never sent to the dashboard.
WA_WABA_ID=
# Optional. When set, campaign review shows eligible contacts × this amount.
# Leave empty to show that Meta has not provided a cost estimate.
MARKETING_PRICE_PER_MESSAGE=
MARKETING_BATCH_SIZE=20
MARKETING_SEND_INTERVAL_MS=250
MARKETING_MAX_ATTEMPTS=4
# Unused by the sender. The worker sleeps until a launch, resume, retry, or the hourly recovery check.
MARKETING_TICK_MS=2000
MARKETING_SWEEP_MS=3600000
MARKETING_STUCK_MS=60000
MARKETING_MAX_CONCURRENT=3
# Optional separate model for marketing replies. Falls back to WA_AI_MODEL.
MARKETING_AI_MODEL=

# Gmail booking channel. Leave empty until the Google Cloud OAuth client exists.
# Scopes used: gmail.readonly and gmail.send. Refresh tokens are encrypted with EMAIL_TOKEN_KEY.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5014/api/email/google/callback
EMAIL_OAUTH_STATE_SECRET=
EMAIL_TOKEN_KEY=
EMAIL_DASHBOARD_URL=http://localhost:5173/email
EMAIL_SYNC_INTERVAL_MS=60000
